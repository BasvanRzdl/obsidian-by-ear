{
	"name": "obsidian-by-ear",
	"version": "0.2.0",
	"description": "An Obsidian plugin for learning songs by ear.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild src/ledger.ts --bundle --format=esm --outfile=test/ledger.bundle.mjs --alias:obsidian=./test/obsidian-stub.mjs --log-level=error && node test/ledger.test.mjs"
	},
	"keywords": [
		"obsidian",
		"music",
		"transcribe",
		"practice"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.0",
		"obsidian": "latest",
		"typescript": "^5.6.0"
	},
	"dependencies": {
		"signalsmith-stretch": "^1.0.0"
	}
}
